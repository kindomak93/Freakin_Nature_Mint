generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"  
}

model TokenCollection {
  id          String   @id @default(uuid())
  symbol      String   
  name        String
  tokenId     String    // Hedera Token ID e.g., "0.0.10164773"
  isMutable   Boolean  @default(false)
  itemTitle   String   @default("")
  createdAt   DateTime @default(now())

  @@unique([symbol, itemTitle], name: "symbol_itemTitle")
}

model CustodialWallet {
  id               String   @id @default(uuid())
  userId           String?  @unique
  email            String   @unique
  accountNumber    String   @unique // Hedera Account ID (e.g., "0.0.7891011")
  encryptedKey     String   // Encrypted Hedera Private Key
  iv               String   // Initialization Vector for AES
  createdAt        DateTime @default(now())
}

model Nft {
  id           String   @id @default(uuid())
  tokenId      String
  serialNumber String
  ownerUserId  String?
  name         String
  symbol       String
  itemTitle    String?  // <-- Added field for specific token name
  isMutable    Boolean
  image        String?
  description  String?
  rawMetadata  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checkIn      TicketCheckIn?

  @@unique([tokenId, serialNumber])
}

model AuditLog {
  id         String   @id @default(uuid())
  endpoint   String
  method     String
  userId     String?
  statusCode Int?
  ipAddress  String?
  request    String   // Store request payload as JSON string
  response   String?  // Store response body as JSON string
  error      String?  // Store error details if request failed
  durationMs Int      // Processing time in milliseconds
  createdAt  DateTime @default(now())
}

model WebhookJob {
  id         String   @id @default(uuid())
  url        String
  payload    String   // Store JSON payload string
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

model TicketCheckIn {
  id           String    @id @default(uuid())
  tokenId      String
  serialNumber String
  isSpent      Boolean   @default(false)
  scannedAt    DateTime?
  scannedBy    String?   // Gate operator or device ID

  // Foreign key relation to Nft
  nft          Nft       @relation(fields: [tokenId, serialNumber], references: [tokenId, serialNumber], onDelete: Cascade)

  @@unique([tokenId, serialNumber])
}